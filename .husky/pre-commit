#!/usr/bin/env bash

# Run Prettier
bun prettier --write .

# Run ESLint
bun lint --fix

# Run tests (only if test files exist, excluding node_modules)
if [ -n "$(find . -path ./node_modules -prune -o -name '*.test.ts' -o -name '*.test.tsx' -o -name '*.spec.ts' -o -name '*.spec.tsx' -type f 2>/dev/null | grep -v node_modules)" ]; then
  bun test
fi
