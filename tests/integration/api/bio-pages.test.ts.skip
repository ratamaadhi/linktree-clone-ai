/**
 * Integration tests for bio pages API routes
 */

import { GET, POST } from '@/app/api/v1/bio-pages/route';
import { GET as getSingle, PUT, DELETE } from '@/app/api/v1/bio-pages/[id]/route';
import { PATCH } from '@/app/api/v1/bio-pages/[id]/toggle-visibility/route';
import { createMockRequest, createMockAuthRequest, createMockSession } from '@/tests/helpers';

// Mock Better Auth
jest.mock('@/lib/auth', () => ({
  auth: {
    api: {
      getSession: jest.fn(),
    },
  },
}));

// Mock database
jest.mock('@/lib/db', () => ({
  db: {
    query: {
      bioPages: {
        findMany: jest.fn(),
        findFirst: jest.fn(),
      },
    },
    insert: jest.fn(),
    update: jest.fn(),
    delete: jest.fn(),
    select: jest.fn(),
  },
}));

import { db } from '@/lib/db';
import { auth } from '@/lib/auth';

describe('Bio Pages API', () => {
  beforeEach(() => {
    jest.clearAllMocks();
  });

  describe('GET /api/v1/bio-pages', () => {
    it('should return 401 when not authenticated', async () => {
      (auth.api.getSession as jest.Mock).mockResolvedValue(null);

      const request = createMockRequest();
      const response = await GET(request);

      expect(response.status).toBe(401);

      const data = await response.json();
      expect(data.error).toBeDefined();
      expect(data.error.code).toBe('AUTHENTICATION_ERROR');
    });

    it('should return list of bio pages when authenticated', async () => {
      const mockSession = createMockSession({
        userId: '00000000-0000-0000-0000-000000000001',
      });

      (auth.api.getSession as jest.Mock).mockResolvedValue(mockSession);

      const mockPages = [
        {
          id: '1',
          title: 'My Bio Page',
          slug: 'my-bio-page',
          isActive: true,
          createdAt: new Date(),
        },
      ];

      (db.query.bioPages.findMany as jest.Mock).mockResolvedValue(mockPages);
      (db.select as jest.Mock).mockReturnValue({
        from: jest.fn().mockReturnValue({
          where: jest.fn().mockResolvedValue([{ count: 1 }]),
        }),
      });

      const request = createMockAuthRequest({
        userId: '00000000-0000-0000-0000-000000000001',
      });

      const response = await GET(request);

      expect(response.status).toBe(200);

      const data = await response.json();
      expect(data.data).toBeDefined();
      expect(data.data).toEqual(mockPages);
      expect(db.query.bioPages.findMany).toHaveBeenCalled();
    });

    it('should filter by organizationId when provided', async () => {
      const mockSession = createMockSession({
        userId: '00000000-0000-0000-0000-000000000001',
      });

      (auth.api.getSession as jest.Mock).mockResolvedValue(mockSession);
      (db.query.bioPages.findMany as jest.Mock).mockResolvedValue([]);
      (db.select as jest.Mock).mockReturnValue({
        from: jest.fn().mockReturnValue({
          where: jest.fn().mockResolvedValue([{ count: 0 }]),
        }),
      });

      const request = createMockRequest({
        url: 'http://localhost:3000/api/v1/bio-pages?organizationId=org-123',
      });

      await GET(request);

      expect(db.query.bioPages.findMany).toHaveBeenCalled();
    });
  });

  describe('POST /api/v1/bio-pages', () => {
    it('should return 401 when not authenticated', async () => {
      (auth.api.getSession as jest.Mock).mockResolvedValue(null);

      const request = createMockRequest({
        method: 'POST',
        body: {
          title: 'New Bio Page',
          slug: 'new-bio-page',
        },
      });

      const response = await POST(request);

      expect(response.status).toBe(401);
    });

    it('should create new bio page when authenticated', async () => {
      const mockSession = createMockSession({
        userId: '00000000-0000-0000-0000-000000000001',
      });

      (auth.api.getSession as jest.Mock).mockResolvedValue(mockSession);
      (db.query.bioPages.findFirst as jest.Mock).mockResolvedValue(null);

      const newPage = {
        id: '123',
        title: 'New Bio Page',
        slug: 'new-bio-page',
        isActive: true,
        createdAt: new Date(),
      };

      const mockInsert = {
        values: jest.fn().mockReturnThis(),
        returning: jest.fn().mockResolvedValue([newPage]),
      };

      (db.insert as jest.Mock).mockReturnValue(mockInsert);

      const request = createMockAuthRequest({
        userId: '00000000-0000-0000-0000-000000000001',
        method: 'POST',
        body: {
          title: 'New Bio Page',
          slug: 'new-bio-page',
        },
      });

      const response = await POST(request);

      expect(response.status).toBe(201);

      const data = await response.json();
      expect(data.data).toBeDefined();
      expect(data.data.title).toBe('New Bio Page');
      expect(mockInsert.values).toHaveBeenCalled();
      expect(mockInsert.returning).toHaveBeenCalled();
    });

    it('should return 409 when slug already exists', async () => {
      const mockSession = createMockSession({
        userId: '00000000-0000-0000-0000-000000000001',
      });

      (auth.api.getSession as jest.Mock).mockResolvedValue(mockSession);

      const existingPage = {
        id: '123',
        title: 'Existing Page',
        slug: 'existing-slug',
      };

      (db.query.bioPages.findFirst as jest.Mock).mockResolvedValue(existingPage);

      const request = createMockAuthRequest({
        userId: '00000000-0000-0000-0000-000000000001',
        method: 'POST',
        body: {
          title: 'New Bio Page',
          slug: 'existing-slug',
        },
      });

      const response = await POST(request);

      expect(response.status).toBe(409);

      const data = await response.json();
      expect(data.error.code).toBe('DUPLICATE_RESOURCE');
    });

    it('should return 400 for invalid input', async () => {
      const mockSession = createMockSession({
        userId: '00000000-0000-0000-0000-000000000001',
      });

      (auth.api.getSession as jest.Mock).mockResolvedValue(mockSession);

      const request = createMockAuthRequest({
        userId: '00000000-0000-0000-0000-000000000001',
        method: 'POST',
        body: {
          title: '', // Invalid: empty title
          slug: 'ab', // Invalid: too short
        },
      });

      const response = await POST(request);

      expect(response.status).toBe(400);

      const data = await response.json();
      expect(data.error.code).toBe('VALIDATION_ERROR');
    });
  });

  describe('GET /api/v1/bio-pages/:id', () => {
    it('should return 401 when not authenticated', async () => {
      (auth.api.getSession as jest.Mock).mockResolvedValue(null);

      const request = createMockRequest();
      const response = await getSingle(request, { params: { id: '123' } });

      expect(response.status).toBe(401);
    });

    it('should return 404 for non-existent bio page', async () => {
      const mockSession = createMockSession({
        userId: '00000000-0000-0000-0000-000000000001',
      });

      (auth.api.getSession as jest.Mock).mockResolvedValue(mockSession);
      (db.query.bioPages.findFirst as jest.Mock).mockResolvedValue(null);

      const request = createMockAuthRequest({
        userId: '00000000-0000-0000-0000-000000000001',
      });

      const response = await getSingle(request, { params: { id: '123' } });

      expect(response.status).toBe(404);

      const data = await response.json();
      expect(data.error.code).toBe('NOT_FOUND');
    });

    it('should return bio page when found', async () => {
      const mockSession = createMockSession({
        userId: '00000000-0000-0000-0000-000000000001',
      });

      (auth.api.getSession as jest.Mock).mockResolvedValue(mockSession);

      const mockPage = {
        id: '123',
        title: 'My Bio Page',
        slug: 'my-bio-page',
        userId: '00000000-0000-0000-0000-000000000001',
        links: [],
      };

      (db.query.bioPages.findFirst as jest.Mock).mockResolvedValue(mockPage);

      const request = createMockAuthRequest({
        userId: '00000000-0000-0000-0000-000000000001',
      });

      const response = await getSingle(request, { params: { id: '123' } });

      expect(response.status).toBe(200);

      const data = await response.json();
      expect(data.data).toBeDefined();
      expect(data.data.id).toBe('123');
    });
  });

  describe('PUT /api/v1/bio-pages/:id', () => {
    it('should return 401 when not authenticated', async () => {
      (auth.api.getSession as jest.Mock).mockResolvedValue(null);

      const request = createMockRequest({ method: 'PUT' });
      const response = await PUT(request, { params: { id: '123' } });

      expect(response.status).toBe(401);
    });

    it('should update bio page when authorized', async () => {
      const mockSession = createMockSession({
        userId: '00000000-0000-0000-0000-000000000001',
      });

      (auth.api.getSession as jest.Mock).mockResolvedValue(mockSession);

      const existingPage = {
        id: '123',
        title: 'Old Title',
        slug: 'old-slug',
        userId: '00000000-0000-0000-0000-000000000001',
        publishedAt: null,
      };

      (db.query.bioPages.findFirst as jest.Mock).mockResolvedValue(existingPage);

      const updatedPage = {
        id: '123',
        title: 'New Title',
        slug: 'old-slug',
        userId: '00000000-0000-0000-0000-000000000001',
        updatedAt: new Date(),
      };

      const mockUpdate = {
        set: jest.fn().mockReturnThis(),
        where: jest.fn().mockReturnThis(),
        returning: jest.fn().mockResolvedValue([updatedPage]),
      };

      (db.update as jest.Mock).mockReturnValue(mockUpdate);

      const request = createMockAuthRequest({
        userId: '00000000-0000-0000-0000-000000000001',
        method: 'PUT',
        body: {
          title: 'New Title',
        },
      });

      const response = await PUT(request, { params: { id: '123' } });

      expect(response.status).toBe(200);

      const data = await response.json();
      expect(data.data.title).toBe('New Title');
    });

    it('should return 404 for non-existent bio page', async () => {
      const mockSession = createMockSession({
        userId: '00000000-0000-0000-0000-000000000001',
      });

      (auth.api.getSession as jest.Mock).mockResolvedValue(mockSession);
      (db.query.bioPages.findFirst as jest.Mock).mockResolvedValue(null);

      const request = createMockAuthRequest({
        userId: '00000000-0000-0000-0000-000000000001',
        method: 'PUT',
        body: {
          title: 'New Title',
        },
      });

      const response = await PUT(request, { params: { id: '123' } });

      expect(response.status).toBe(404);
    });
  });

  describe('DELETE /api/v1/bio-pages/:id', () => {
    it('should return 401 when not authenticated', async () => {
      (auth.api.getSession as jest.Mock).mockResolvedValue(null);

      const request = createMockRequest({ method: 'DELETE' });
      const response = await DELETE(request, { params: { id: '123' } });

      expect(response.status).toBe(401);
    });

    it('should delete bio page when authorized', async () => {
      const mockSession = createMockSession({
        userId: '00000000-0000-0000-0000-000000000001',
      });

      (auth.api.getSession as jest.Mock).mockResolvedValue(mockSession);

      const existingPage = {
        id: '123',
        userId: '00000000-0000-0000-0000-000000000001',
      };

      (db.query.bioPages.findFirst as jest.Mock).mockResolvedValue(existingPage);

      const mockDelete = {
        where: jest.fn().mockResolvedValue(undefined),
      };

      (db.delete as jest.Mock).mockReturnValue(mockDelete);

      const request = createMockAuthRequest({
        userId: '00000000-0000-0000-0000-000000000001',
        method: 'DELETE',
      });

      const response = await DELETE(request, { params: { id: '123' } });

      expect(response.status).toBe(200);

      const data = await response.json();
      expect(data.message).toBeDefined();
    });
  });

  describe('PATCH /api/v1/bio-pages/:id/toggle-visibility', () => {
    it('should return 401 when not authenticated', async () => {
      (auth.api.getSession as jest.Mock).mockResolvedValue(null);

      const request = createMockRequest({ method: 'PATCH' });
      const response = await PATCH(request, { params: { id: '123' } });

      expect(response.status).toBe(401);
    });

    it('should toggle visibility to false', async () => {
      const mockSession = createMockSession({
        userId: '00000000-0000-0000-0000-000000000001',
      });

      (auth.api.getSession as jest.Mock).mockResolvedValue(mockSession);

      const existingPage = {
        id: '123',
        userId: '00000000-0000-0000-0000-000000000001',
        isActive: true,
        publishedAt: new Date(),
      };

      (db.query.bioPages.findFirst as jest.Mock).mockResolvedValue(existingPage);

      const updatedPage = {
        id: '123',
        isActive: false,
        updatedAt: new Date(),
      };

      const mockUpdate = {
        set: jest.fn().mockReturnThis(),
        where: jest.fn().mockReturnThis(),
        returning: jest.fn().mockResolvedValue([updatedPage]),
      };

      (db.update as jest.Mock).mockReturnValue(mockUpdate);

      const request = createMockAuthRequest({
        userId: '00000000-0000-0000-0000-000000000001',
        method: 'PATCH',
        body: {
          isActive: false,
        },
      });

      const response = await PATCH(request, { params: { id: '123' } });

      expect(response.status).toBe(200);

      const data = await response.json();
      expect(data.data.isActive).toBe(false);
    });
  });
});
